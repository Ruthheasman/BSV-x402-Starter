# BSV x402 Micropayment API Starter - Environment Variables
# Copy this file to .env or add these as Replit Secrets

# BSV private key for wallet (hex-encoded or WIF format)
# Generate one: node -e "const { PrivateKey } = require('@bsv/sdk'); const k = PrivateKey.fromRandom(); console.log('WIF:', k.toWif()); console.log('Hex:', k.toHex()); console.log('Address:', k.toAddress())"
# Without this, the app runs in demo mode (no auth/payment required)
SERVER_PRIVATE_KEY=

# Optional: custom service name (default: "bsv-x402-starter")
SERVICE_NAME=
